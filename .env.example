# Telegram bot token, from @BotFather
TELEGRAM_BOT_TOKEN=

# The chat/channel the bot watches for new "thoughts".
# For a channel: add the bot as an admin (with "post messages" rights so it
# can reply), then set this to the channel's @username (e.g. @my_channel) or
# its numeric chat id (channels are usually negative, like -1001234567890).
# For a private group/DM: the numeric chat id works the same way.
TELEGRAM_CHAT_ID=

# Google Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated fallback keys. If the first key hits a quota
# limit or gets revoked (401/403/429), the bot automatically tries the next
# one in the list.
GEMINI_API_KEYS=

# Optional overrides
GEMINI_MODEL=gemini-3.1-pro-preview
POLL_INTERVAL_SECONDS=5
